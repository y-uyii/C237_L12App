<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Expense</title>
</head>
<body>
    <%- include('partials/navbar') %>
    <h1>Edit Expense</h1>
    <form action="/edit/<%= index %>" method="POST">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= name %>" required><br>
        <label for="type">Type:</label>
        <select id="type" name="type" required>
            <option value="transport" <%= type === 'transport' ? 'selected' : '' %>>Transport</option>
            <option value="food" <%= type === 'food' ? 'selected' : '' %>>Food</option>
            <option value="shopping" <%= type === 'shopping' ? 'selected' : '' %>>Shopping</option>
            <option value="other" <%= type === 'other' ? 'selected' : '' %>>Other</option>
        </select><br><br>
        <label for="date">Date:</label>
        <input type="date" id="date" name="date" value="<%= date %>" required><br><br>
        <label for="cost">Cost:</label>
        <input type="number" id="cost" name="cost" step="0.01" value="<%= cost %>" required><br><br>
        <button type="submit">Update</button>
    </form>
    <button onclick="window.location.href='/history'">Cancel</button>
</body>
</body>
</html>